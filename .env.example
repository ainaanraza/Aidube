# Aidube Server-Side Environment Variables
# Configure these in your Vercel Project Settings -> Environment Variables
# or in a local uncommitted .env file for local testing.

# Google Gemini API Key (or comma-separated pool for automatic quota fallback)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional pool: GEMINI_API_KEYS=key1,key2,key3

# YouTube Data API v3 Key (or comma-separated pool for quota fallback)
YOUTUBE_API_KEY=your_youtube_api_key_here
# Optional pool: YOUTUBE_API_KEYS=key1,key2,key3

# Optional: YouTube proxy URL if running in an IP-restricted environment
# YOUTUBE_PROXY=http://user:password@proxy.example.com:8080

# Optional: reCAPTCHA Enterprise Key
# RECAPTCHA_API_KEY=your_recaptcha_api_key_here
